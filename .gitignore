# .gitignore for Node.js Projects
# ---------- Start of common ignore files

# Log files
**/*.log

# dotenv environment variables file
**/.env

# JetBrains IDEs
**/.idea/
**/*.iml

# AI
.claude/worktree
.claude/*.local.json

# Visual Studio Code IDE
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
!**/.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# Generated by MacOS
.DS_Store
.AppleDouble
.LSOverride

# Generated by Windows
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Applications
*.app
*.pkg
*.dmg
*.exe
*.war
*.deb

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# ---------- End of common ignore files

#### [JavaScript] ####
# Node artifact files
**/node_modules/

# Project files
**/dist/

# Test output
**/coverage/
**/__screenshots__/
**/.vitest-attachments/

#### [Dart / Flutter] ####
# Tool and build output
**/.dart_tool/
**/.flutter-plugins-dependencies
**/build/

# The pub lockfile of a library is not committed; the example keeps its own
packages/flutter/pubspec.lock

# The Flutter gallery the documentation site builds into its public folder
docs/src/public/flutter/
